# Local application
FASTAPI_ENV=development
DEMO_MODE=false
BACKEND_RELOAD=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
